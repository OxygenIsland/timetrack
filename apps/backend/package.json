{
  "name": "@timetrack/backend",
  "version": "0.1.0",
  "private": true,
  "description": "TimeTrack 后端服务 - FastAPI + SQLAlchemy + SQLite（由 uv 管理依赖）",
  "scripts": {
    "dev": "uv run --with uvicorn[standard] uvicorn app.main:app --reload --port 8000 --host 127.0.0.1",
    "start": "uv run uvicorn app.main:app --port 8000 --host 127.0.0.1",
    "seed": "uv run python -m scripts.seed_db",
    "sync": "uv sync --group dev",
    "test": "uv run pytest",
    "lint": "uv run ruff check app scripts",
    "format": "uv run black app scripts"
  }
}
