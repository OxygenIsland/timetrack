# TimeTrack 后端配置示例
# 复制为 .env 后按需修改

# ===== 应用基础配置 =====
APP_NAME=TimeTrack Backend
APP_ENV=development
APP_VERSION=0.1.0
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# ===== CORS 配置（开发模式：允许 Vite 5173 + Electron） =====
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","app://.","file://"]

# ===== 数据库配置 =====
# 一期用 SQLite，文件存放在 apps/backend/data/timetrack.db
DATABASE_URL=sqlite:///./data/timetrack.db

# ===== 日志配置 =====
LOG_LEVEL=INFO
LOG_DIR=./data/logs
LOG_FILE_MAX_BYTES=10485760   # 10MB
LOG_FILE_BACKUP_COUNT=10

# ===== 安全配置（占位，一期暂未启用） =====
# JWT_SECRET=change-me-in-production
# JWT_EXPIRE_MINUTES=1440
