{
  "name": "@timetrack/frontend",
  "version": "1.0.0",
  "private": true,
  "description": "TimeTrack 前端应用 - Electron + Vite + React",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron dist-electron/main.js",
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && vite build",
    "build": "pnpm build:web && pnpm build:electron",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "antd": "^5.21.0",
    "@ant-design/icons": "^5.5.1",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "uuid": "^10.0.0",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "reconnecting-websocket": "^4.4.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  }
}
